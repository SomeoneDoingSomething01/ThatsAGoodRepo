local function punishNPC(npc)
    local hrp = npc:FindFirstChild("HumanoidRootPart")
    local hum = npc:FindFirstChildOfClass("Humanoid")

    if hrp and hum then
        if not Players:GetPlayerFromCharacter(npc) then
            if not string.find(string.lower(npc.Name), "lucky block") then
                
                hrp.Anchored = false
                
                npc:PivotTo(CFrame.new(
                    math.random(-50,50),
                    1000,
                    math.random(-50,50)
                ))

                hrp.Velocity = Vector3.new(0,200,0)
                hrp.RotVelocity = Vector3.new(999,999,999)

                hum:ChangeState(Enum.HumanoidStateType.Physics)
            end
        end
    end
end

for _, v in pairs(workspace:GetDescendants()) do
    if v:IsA("Model") then
        punishNPC(v)
    end
end
