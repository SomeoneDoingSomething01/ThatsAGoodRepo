local function GetTorso()
    local Character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()

    return Character:FindFirstChild("UpperTorso")
        or Character:FindFirstChild("Torso")
        or Character:FindFirstChild("HumanoidRootPart")
end

Tabs.Main:AddToggle("CoinMagnet", {
    Title = "Auto Collect Coin",
    Default = false,
    Callback = function(Value)
        if Value then
            if CoinMagnetConnection then
                CoinMagnetConnection:Disconnect()
            end

            CoinMagnetConnection = RunService.Heartbeat:Connect(function()
                local Torso = GetTorso()
                if not Torso then return end

                for _, Coin in ipairs(CoinsFolder:GetChildren()) do
                    if Coin:IsA("BasePart") then
                        Coin.CFrame = Torso.CFrame
                        Coin.AssemblyLinearVelocity = Vector3.zero
                        Coin.AssemblyAngularVelocity = Vector3.zero
                    elseif Coin:IsA("Model") then
                        Coin:PivotTo(Torso.CFrame)
                    end
                end
            end)
        else
            if CoinMagnetConnection then
                CoinMagnetConnection:Disconnect()
                CoinMagnetConnection = nil
            end
        end
    end
})
